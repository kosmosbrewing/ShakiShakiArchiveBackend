# .dockerignore
# Docker 빌드 시 제외할 파일/폴더

# 의존성 (컨테이너 내에서 새로 설치)
node_modules

# 빌드 결과물 (컨테이너 내에서 새로 빌드)
dist
build

# 환경 변수 (보안 - 절대 이미지에 포함 금지)
.env
.env.*
!.env.example

# Git
.git
.gitignore

# 개발 도구
.vscode
.idea
*.swp
*.swo

# 로그
logs
*.log
npm-debug.log*

# 테스트
coverage
.nyc_output
*.test.ts
*.spec.ts
__tests__

# 문서
README.md
CLAUDE.md
docs
*.md

# OS 파일
.DS_Store
Thumbs.db

# TypeScript 캐시
*.tsbuildinfo

# 기타
.replit
replit.nix
