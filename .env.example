# ShakiShaki Archive Backend
# 로컬 개발용 안전한 기본값 예시입니다. 실제 비밀값을 커밋하지 마세요.

# -----------------------------------------------------------------------------
# 필수
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shakishaki_dev
# 생성 예: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# -----------------------------------------------------------------------------
# 서버 / 브라우저 연동
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# 운영에서는 기본값(true)을 유지해야 cross-origin SameSite=None 쿠키가 동작합니다.
SECURE_COOKIE=false
# API Gateway/VPC Link 헤더 진단 시에만 true. 요청 헤더 메타데이터가 로그에 남습니다.
DEBUG_PROXY_HEADERS=false

# 자체 콘솔 로거: debug | info | warn | error
# 운영 기본 warn, 개발 기본 info
# LOG_LEVEL=info
# LOG_COLOR=false
# LOG_PRETTY=false


# -----------------------------------------------------------------------------
# PostgreSQL / Drizzle
# -----------------------------------------------------------------------------
# 앱 연결은 운영에서 기본 SSL=true, 개발에서 기본 false입니다.
DB_SSL=false
# CA 우선순위: DB_SSL_CA > RDS_CA_BUNDLE > certs/rds-ca-bundle.pem
# DB_SSL_CA=/absolute/path/to/rds-ca-bundle.pem
# RDS_CA_BUNDLE=/app/certs/rds-ca-bundle.pem
# 운영 기본 20, 개발 기본 10
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=10000

# -----------------------------------------------------------------------------
# 관리자 생성 / 2차 인증
# -----------------------------------------------------------------------------
# 운영에서는 코드의 임시 복구 기본값을 사용하지 말고 별도 6자리 숫자 secret으로 주입합니다.
# 아래 placeholder는 의도적으로 유효 형식이 아니어서 로컬 복구 경로를 활성화하지 않습니다.
ADMIN_2FA_RECOVERY_CODE=replace-with-a-private-recovery-code
# 비대화형 server/scripts/create-admin.ts 전용
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_NAME=Administrator

# -----------------------------------------------------------------------------
# OAuth (선택)
# -----------------------------------------------------------------------------
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_CALLBACK_URL=http://localhost:8080/api/oauth/naver/callback
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=http://localhost:8080/api/oauth/kakao/callback

# 카카오 주소/키워드 검색 API용 키. OAuth client ID와 별도로 읽습니다.
# KAKAO_REST_API_KEY=

# -----------------------------------------------------------------------------
# 결제 (선택, 키가 없으면 해당 기능 비활성화)
# -----------------------------------------------------------------------------
# 토스페이먼츠: TOSS_SECRET_KEY가 활성화 플래그입니다.
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# 카카오페이 단건결제: KAKAOPAY_SECRET_KEY가 활성화 플래그입니다.
# KAKAOPAY_CID=TC0ONETIME
# KAKAOPAY_SECRET_KEY=
# KAKAOPAY_MODE=dev
# KAKAOPAY_RETURN_URL=http://localhost:8080/api/payments/kakaopay/callback

# 네이버페이 결제형: NAVERPAY_CLIENT_ID가 활성화 플래그입니다.
# NAVERPAY_CLIENT_ID=
# NAVERPAY_CLIENT_SECRET=
# NAVERPAY_CHAIN_ID=
# NAVERPAY_MERCHANT_ID=
# NAVERPAY_MODE=test
# NAVERPAY_RETURN_URL=http://localhost:8080/api/payments/naverpay/callback

# 네이버페이 주문형: NAVERPAY_CERTI_KEY가 활성화 플래그입니다.
# NAVERPAY_CERTI_KEY=
# NAVERPAY_BUTTON_KEY=

# -----------------------------------------------------------------------------
# 이메일 / 알림 (선택)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=ShakiShaki Archive

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# 시스템 오류를 별도 채널로 보낼 때 설정. 미설정 시 TELEGRAM_CHAT_ID 사용
# TELEGRAM_ADMIN_CHAT_ID=

# -----------------------------------------------------------------------------
# 이미지 / 검색 / 통계 (선택)
# -----------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# MEILISEARCH_HOST를 설정해야 검색 엔진 초기화가 활성화됩니다.
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=
# MEILISEARCH_PRODUCTS_INDEX=products

# GA4 관리자 통계
# GA4_PROPERTY_ID=123456789
# GA4_CLIENT_EMAIL=ga4-reader@example.iam.gserviceaccount.com
# GA4_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# -----------------------------------------------------------------------------
# SEO / 프론트엔드 재빌드 (선택)
# -----------------------------------------------------------------------------
# SITE_NAME=샤키샤키 아카이브
# SITE_DESCRIPTION=여성 빈티지 쇼핑몰 | 샤키샤키 아카이브
# HOME_SEO_TITLE=
# HOME_SEO_DESCRIPTION=
# SITE_LOGO=https://example.com/logo.png

# 상품 변경 시 프론트엔드 repository_dispatch. 토큰 미설정 시 no-op입니다.
# GITHUB_DISPATCH_TOKEN=
# GITHUB_FRONTEND_REPO=kosmosbrewing/ShakiShakiArchive

# -----------------------------------------------------------------------------
# Rate limit (선택; 미설정 시 shared/constants/security.ts)
# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=1000
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX_REQUESTS=15
# 개발에서도 전역/auth limiter를 켜려면 true
# RATE_LIMIT_ENABLE_IN_DEV=false
