# .env.example
# AWS App Runner 환경 변수 설정 참고용

# ============================================
# 필수 환경 변수
# ============================================

# PostgreSQL 데이터베이스 연결 문자열
DATABASE_URL=postgresql://postgres:postgres@shakishaki-db.ct1234uuj.ap-northeast-2.rds.amazonaws.com:5432/shakishaki_db?sslmode=require
# 세션 암호화 키 (최소 32자 이상 권장)
SESSION_SECRET=your-super-secret-session-key-here

# ============================================
# 서버 설정
# ============================================

# 실행 환경 (production / development)
NODE_ENV=production

# 서버 포트 (App Runner 기본값: 8080)
PORT=8080

# HTTPS 쿠키 비활성화 (프록시 뒤에서 HTTP 사용 시)
# SECURE_COOKIE=false

# DB SSL 연결 설정
# - true: SSL 활성화
# - false: SSL 비활성화
# - 미설정: production에서는 true, 그 외에는 false
DB_SSL=false

# SSL CA 인증서 경로 (AWS RDS 연결 시)
# 우선순위: DB_SSL_CA > RDS_CA_BUNDLE(Docker) > certs/rds-ca-bundle.pem(로컬)
# DB_SSL_CA=certs/rds-ca-bundle.pem

# CORS 허용 Origin (쉼표로 구분)
CORS_ORIGINS=https://your-frontend-domain.com

# 프론트엔드 URL (OAuth 콜백 리다이렉트용)
FRONTEND_URL=https://your-frontend-domain.com

# ============================================
# 토스페이먼츠 (선택)
# ============================================

# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# ============================================
# 네이버 OAuth (선택)
# ============================================

# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret
# NAVER_CALLBACK_URL=https://your-api-domain.com/api/oauth/naver/callback

# ============================================
# 네이버페이 결제 (선택)
# ============================================

# NAVERPAY_CLIENT_ID=your-naverpay-client-id
# NAVERPAY_CLIENT_SECRET=your-naverpay-client-secret
# NAVERPAY_CHAIN_ID=your-chain-id
# NAVERPAY_MERCHANT_ID=your-merchant-id
# NAVERPAY_MODE=prod
# NAVERPAY_RETURN_URL=https://your-api-domain.com/api/payments/naverpay/callback

# ============================================
# Resend 이메일 (선택)
# ============================================

# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@your-domain.com
# EMAIL_FROM_NAME=ShakiShaki

# ============================================
# Cloudinary 이미지 업로드 (선택)
# ============================================

# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Rate Limiting (선택, 기본값 사용 가능)
# ============================================

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX_REQUESTS=10
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX_REQUESTS=60
